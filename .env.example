# Compose-level configuration. Copy to .env and adjust if needed:
#   cp .env.example .env
# Host ports default to non-standard values so this stack doesn't clash with
# a developer's own local MySQL/Redis. Container-to-container traffic always
# uses the service name (mysql/redis) and the default internal port.

# --- Host port mappings ---
APP_PORT=8000
FRONTEND_PORT=5173
DB_PORT=3307
REDIS_PORT=6380

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=contact_console
MYSQL_USER=contact_console
MYSQL_PASSWORD=secret

# --- App bootstrap behaviour ---
# When true, the `app` container seeds the database on first start if it's
# empty (docker/php/entrypoint.sh). Safe to leave on for local dev; a real
# deploy would set this to false and run seeding as a separate step.
SEED_ON_START=true

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
