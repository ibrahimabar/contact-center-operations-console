[mysqld]
# InnoDB FULLTEXT tuning for contact search (see DECISIONS.md #6).
# Must be set before the FULLTEXT index is created — a value change after
# creation requires OPTIMIZE TABLE to rebuild it.
innodb_ft_min_token_size = 2
innodb_ft_enable_stopword = 0

# Sane defaults for a small local/CI instance.
max_connections = 150
innodb_buffer_pool_size = 256M
