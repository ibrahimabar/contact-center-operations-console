<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!--
            Deliberately real MySQL + Redis, not sqlite/array — see
            DECISIONS.md "Testing strategy". sqlite doesn't support the
            FULLTEXT search or MySQL-specific raw SQL (GREATEST(), the
            atomic conditional UPDATE) this app relies on, and the
            idempotency-lock/rate-limiting tests need a real Redis. A
            separate database (contact_console_test, created by
            docker/mysql/init-test-db.sh) and Redis logical DB (index 2,
            vs. 1 for dev cache) keep this fully isolated from local dev
            state.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="mysql"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="contact_console_test"/>
        <env name="DB_USERNAME" value="contact_console"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="DB_URL" value=""/>
        <env name="CACHE_STORE" value="redis"/>
        <env name="REDIS_HOST" value="redis"/>
        <env name="REDIS_CACHE_DB" value="2"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="database"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
