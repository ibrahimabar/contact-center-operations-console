APP_NAME="Contact Center Operations Console"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Container-to-container hostnames (docker-compose service names), not the
# host-mapped ports in the root .env.example.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=contact_console
DB_USERNAME=contact_console
DB_PASSWORD=secret

# Sessions deliberately stay on the `database` driver, not Redis — see
# DECISIONS.md "Auth" entry: a Redis outage must never be able to break login.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# The React dev server runs on a different port (5173) than the API (8000);
# Sanctum treats same-site-different-port as one of its "stateful" domains.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No background jobs are needed for this scope (see DECISIONS.md "Redis
# usage" — queues were considered and deliberately not adopted); `sync`
# avoids requiring a queue worker container.
QUEUE_CONNECTION=sync

# Backs rate limiting (login + interaction throttles) and the idempotency
# in-flight lock — the only two Redis uses in this app (see DECISIONS.md).
CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
